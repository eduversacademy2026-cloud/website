{
  "routes": [
    {
      "src": "/privacy-policy",
      "dest": "/privacy-policy.html",
      "headers": {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/privacy-policy.html",
      "dest": "/privacy-policy.html",
      "headers": {
        "Content-Type": "text/html; charset=utf-8"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
